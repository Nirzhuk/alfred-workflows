# Publisher-owned GitHub App (device flow, no client secret).
# Create at https://github.com/settings/apps/new, enable Device Flow.
ALFRED_GITHUB_APP_CLIENT_ID=
ALFRED_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new

# Optional: publisher-owned Gmail OAuth client.
ALFRED_GMAIL_CLIENT_ID=
ALFRED_GMAIL_OAUTH_PORT=
